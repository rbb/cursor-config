{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": ".cursor/hooks/post-write-style.py",
        "matcher": "Write|StrReplace",
        "timeout": 10
      }
    ],
    "afterTabFileEdit": [
      {
        "command": ".cursor/hooks/format-tab-edit.py",
        "timeout": 5
      }
    ],
    "sessionStart": [
      {
        "command": ".cursor/hooks/check-tooling.py",
        "timeout": 5
      }
    ]
  }
}
